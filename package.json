{
  "name": "proj_okf-graph",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run apps/okf-graph/src/index.ts",
    "build": "vp run -r --no-cache build",
    "dev": "vp run -r --parallel --no-cache dev",
    "type-check": "vp run -r type-check",
    "clean": "vp cache clean && vp run --no-cache --filter \"./apps/*\" --filter \"./packages/*\" clean && git clean -xdf node_modules .cache dist tsconfig.tsbuildinfo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vp run -r test",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "vite-plus": "^1.5.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "vitest": "^5.1.0",
    "@effect/tsgo": "0.67.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

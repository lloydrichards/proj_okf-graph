{
  "name": "proj_okf-graph",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run apps/okf-graph/src/index.ts",
    "build": "vp run -r build",
    "dev": "vp run -r --parallel --no-cache dev",
    "type-check": "vp run -r type-check",
    "clean": "vp cache clean && vp run --no-cache --filter \"./apps/*\" --filter \"./packages/*\" clean && git clean -xdf node_modules .cache dist tsconfig.tsbuildinfo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vp run -r test",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "vite-plus": "^0.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "vitest": "^4.1.11",
    "@effect/tsgo": "0.38.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

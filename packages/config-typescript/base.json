{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "display": "Default",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "preserveWatchOutput": true,
    "removeComments": false,
    "sourceMap": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "barrelImportPackages": ["effect"],
        "includeSuggestionsInTsc": true,
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "cryptoRandomUUIDInEffect": "suggestion",
          "globalDateInEffect": "suggestion",
          "layerMergeAllWithDependencies": "warning",
          "missingEffectServiceDependency": "warning"
        },
        "allowedUnstableApis": [
          "@effect/platform-bun/BunRuntime",
          "@effect/platform-bun/BunServices",
          "@effect/platform-node-shared/NodeSink",
          "@effect/platform-node-shared/NodeStream",
          "@effect/platform-node/NodeServices",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/Graph",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/Terminal",
          "effect/cli/Argument",
          "effect/cli/Command",
          "effect/cli/Flag",
          "effect/cli/Prompt",
          "effect/crypto/Digest",
          "effect/crypto/SecureRandom",
          "effect/devtools/DevTools",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientError",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner"
        ]
      }
    ]
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
